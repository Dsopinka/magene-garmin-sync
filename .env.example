# Copy to .env and fill in. Keep this file private; it holds your passwords.

# --- Onelap / Magene international (OnelapFit) account ---
ONELAP_ACCOUNT=you@example.com
ONELAP_PASSWORD=your-onelap-password
# Fill these in after running `probe` (see README). Leave as-is for the first run.
ONELAP_HOST=
ONELAP_HASH_PASSWORD=0

# --- Garmin Connect account ---
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
# Only set this if 2FA is on AND cached tokens expired:
GARMIN_MFA=

# --- behaviour ---
POLL_SECONDS=3600
LOOKBACK_PAGES=1
